# Arduino IDE
*.hex
!extras/golden/*.hex
# The fuzz seed corpus is source, not build output. Without this the `*.hex`
# rule above silently excludes it, and CI's deterministic replay gate runs
# with only the golden vectors as seeds.
!test/fuzz/corpus/*.hex
